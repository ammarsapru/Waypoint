# Copy this file to .env and put secrets only in the copied .env file.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPEN_ROUTER_KEY is also accepted as a compatibility alias.
WAYPOINT_MODEL=claude-sonnet-5

# Provider architecture. Keep "single" for one shared model across every call.
# Set "dual" to split evidence investigation (cheaper model) from final answer/
# finding synthesis (stronger model) - every agent loop (Ask, onboarding,
# issues) shares one resolved provider per conversation either way.
WAYPOINT_MODEL_ARCHITECTURE=single

# Dual-role model selection (used when WAYPOINT_MODEL_ARCHITECTURE=dual).
# These are first-party Anthropic API model ids/aliases, used on the
# "anthropic-api" cascade tier below - see WAYPOINT_*_BEDROCK_MODEL for the
# Bedrock-tier equivalents.
WAYPOINT_INVESTIGATION_MODEL=claude-sonnet-5
WAYPOINT_SYNTHESIS_MODEL=claude-opus-5
WAYPOINT_INVESTIGATION_ROUNDS=3
WAYPOINT_SYNTHESIS_MAX_ATTEMPTS=2

# Amazon Bedrock - the preferred provider tier when AWS_REGION is set (tried
# before the direct Anthropic API; see the cascade order below). Model ids
# carry Bedrock's "us.anthropic." region/provider prefix, not the bare
# first-party alias.
AWS_REGION=
# Optional: only needed if not using boto3's default credential chain (an AWS
# profile or IAM role already configured on the host/container).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WAYPOINT_BEDROCK_TIMEOUT_SECONDS=180
# Single-model architecture's Bedrock model.
WAYPOINT_BEDROCK_PRIMARY_MODEL=us.anthropic.claude-sonnet-4-6
# Dual-role architecture's per-role Bedrock models.
WAYPOINT_INVESTIGATION_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
WAYPOINT_SYNTHESIS_BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1

# OpenRouter and Gemini are used only by the model-comparison/benchmark tooling
# (backend/app/agent/comparison.py) via WAYPOINT_INVESTIGATION_PROVIDER/
# WAYPOINT_SYNTHESIS_PROVIDER below - NOT by the main Ask/onboarding/issues
# cascade, which always tries Bedrock -> Anthropic API -> Bedrock (retry) ->
# Claude Code, in that order, regardless of these two settings.
# Providers: openrouter, claude-code, anthropic-api, bedrock, auto.
WAYPOINT_INVESTIGATION_PROVIDER=auto
WAYPOINT_SYNTHESIS_PROVIDER=auto
WAYPOINT_OPENROUTER_TIMEOUT_SECONDS=180
# WAYPOINT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=
WAYPOINT_GEMINI_TIMEOUT_SECONDS=180
WAYPOINT_GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview
# WAYPOINT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Uses the locally authenticated Claude Code subscription as the last cascade
# tier, once Bedrock and the direct Anthropic API have both failed with a
# billing/capacity error.
WAYPOINT_CLAUDE_CODE_FALLBACK=1
# Uses the Sonnet alias by default; leave empty to use Claude Code's account default.
WAYPOINT_CLAUDE_CODE_MODEL=sonnet
WAYPOINT_CLAUDE_CODE_TIMEOUT_SECONDS=180
# Internal Claude Code turns used to produce one structured Waypoint action batch.
WAYPOINT_CLAUDE_CODE_MAX_TURNS=8
# Optional hard SDK-session cost ceiling; 0 or blank disables it.
# WAYPOINT_CLAUDE_CODE_MAX_BUDGET_USD=0.35
# Sends one minimal API prompt during backend startup to detect billing/capacity failures.
WAYPOINT_PROVIDER_STARTUP_PROBE=1
WAYPOINT_CHAT_HISTORY_TURNS=12
# Hybrid memory: add up to six semantically relevant older turns to the recent window.
WAYPOINT_CHAT_SEMANTIC_MEMORY_ITEMS=6
WAYPOINT_CHAT_MEMORY_RETENTION_TURNS=200
WAYPOINT_CHAT_MEMORY_MAX_CHARACTERS=8000
WAYPOINT_CHAT_MEMORY_MIN_SIMILARITY=0.12
WAYPOINT_AGENT_MAX_TOOL_ROUNDS=8
WAYPOINT_AGENT_MAX_SCHEMA_CORRECTIONS=2
WAYPOINT_AGENT_MAX_SUBMISSION_CORRECTIONS=2
WAYPOINT_AGENT_MAX_OUTPUT_TOKENS=6000

# Comma-separated browser origins allowed to call a separately hosted backend.
# Example: https://waypoint-your-team.vercel.app
WAYPOINT_CORS_ORIGINS=

# Optional: increases GitHub API limits for issue history.
GITHUB_TOKEN=

# Optional: persisted chat and analysis state location.
# WAYPOINT_STATE_PATH=.waypoint-data/waypoint.sqlite3

# Optional diagnostics.
ONBOARD_LOG_LEVEL=INFO
ONBOARD_LOG_VALUE_LIMIT=4000
ONBOARD_TRACE_FUNCTIONS=1
ONBOARD_MAX_TRACE=0
ONBOARD_TRACE_FILE=1
# ONBOARD_TRACE_PATH=.waypoint-data/traces/waypoint.jsonl
